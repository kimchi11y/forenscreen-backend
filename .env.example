# ForenScreen backend configuration.
# Copy to .env and fill in. .env is gitignored - never commit it.

# --- Database ---------------------------------------------------------------
# Neon pooled connection string. Keep the -pooler host for application traffic.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# --- On-chain anchoring -----------------------------------------------------
# Optional. Without these three, anchoring degrades to anchor_status='failed'
# and everything else keeps working - registration and verification never
# depend on the chain being reachable.

# An RPC endpoint for Sepolia (Alchemy, Infura, QuickNode, ...).
SEPOLIA_RPC_URL=

# Printed by: python scripts/deploy_contract.py
REGISTRY_CONTRACT_ADDRESS=

# A THROWAWAY key holding a little Sepolia test ETH. Never a personal wallet:
# this signs every anchor and a testnet key in a file is a testnet key in a file.
ANCHOR_PRIVATE_KEY=

# Optional overrides
# CHAIN_ID=11155111
# CHAIN_EXPLORER_URL=https://sepolia.etherscan.io

# --- Auth (Neon managed Better Auth) ----------------------------------------
# Branch Auth URL including its path - `neon neon-auth status`. Used to verify
# bearer tokens from the frontend; the JWKS URL is derived from it.
# Note the token's iss/aud are the bare origin of this URL, without the path.
NEON_AUTH_BASE_URL=

# Optional overrides, only needed if the token claims ever differ.
# NEON_AUTH_JWKS_URL=
# NEON_AUTH_ISSUER=
# NEON_AUTH_AUDIENCE=
